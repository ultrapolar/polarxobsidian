{
  "name": "polar-sync",
  "version": "0.1.0",
  "description": "Sync Polar Flow data (sleep, Nightly Recharge, exercises) into Obsidian notes via the Polar AccessLink API.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "node esbuild.config.mjs test && node --test test/render.test.mjs",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "polar",
    "accesslink",
    "health",
    "quantified-self"
  ],
  "author": "ultrapolar",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.21.0",
    "obsidian": "^1.13.1",
    "tslib": "^2.6.0",
    "typescript": "^5.4.0"
  }
}
